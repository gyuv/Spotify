# Create an app at https://developer.spotify.com/dashboard and paste its Client ID.
VITE_SPOTIFY_CLIENT_ID=
# Must exactly match a Redirect URI registered in the dashboard.
# Web: http://127.0.0.1:5173/callback   Native (Capacitor): rymusic://callback
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
# Optional: YouTube Data API v3 key — enables Motion mode (muted official music video synced to Spotify).
VITE_YOUTUBE_API_KEY=
# Optional: Party Rooms relay (run `npm run party`). Use wss:// in production.
VITE_PARTY_URL=ws://127.0.0.1:8787
