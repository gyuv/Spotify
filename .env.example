# Create an app at https://developer.spotify.com/dashboard and paste its Client ID.
VITE_SPOTIFY_CLIENT_ID=
# Must exactly match a Redirect URI registered in the dashboard.
# Web: http://127.0.0.1:5173/callback   Native (Capacitor): rymusic://callback
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
# Optional Motion mode (music videos): set YOUTUBE_API_KEY (no VITE_ prefix) in Vercel → Environment
# Variables. It is used only by the server function api/yt.js and never sent to the browser.
# Native apps: point at the deployed site so they can reach that function.
VITE_API_BASE=
# Optional: Party Rooms relay (run `npm run party`). Use wss:// in production.
VITE_PARTY_URL=ws://127.0.0.1:8787
# Optional: synced-lyrics source. Defaults to the public LRCLIB (https://lrclib.net); point at a self-hosted mirror if you like.
VITE_LYRICS_URL=https://lrclib.net
